# LLM-adapter. API-nyckeln används endast på serversidan.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Byt till valfri OpenAI-kompatibel tjänst, till exempel lokal Ollama/LM Studio.
LLM_API_URL=https://api.openai.com/v1/chat/completions

# Ollama (lokalt, utan API-nyckel):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:3b
# LLM_API_URL=http://127.0.0.1:11434/api/generate

# Gemini Developer API (moln, gratisnivå för vissa modeller):
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
